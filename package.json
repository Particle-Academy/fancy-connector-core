{
  "name": "@particle-academy/fancy-connector-core",
  "version": "0.3.0",
  "description": "The runtime under every Fancy connector: modes and estates, connections, one call path, a failure taxonomy that separates \"it never arrived\" from \"nobody can tell\", deterministic fakers, webhook verification, pure versioned rendering, declared metric shapes, credential-free probes, and API-drift reporting. Owns the wire; never the gates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-connector-core.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-connector-core#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-connector-core/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "connectors",
    "api",
    "integrations",
    "webhooks",
    "idempotency",
    "retry",
    "openapi",
    "api-drift",
    "fancy-ui",
    "particle-academy"
  ],
  "license": "MIT",
  "sideEffects": false,
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
