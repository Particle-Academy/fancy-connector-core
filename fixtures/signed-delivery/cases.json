        "reason": "signature did not match"
      }
    },
    {
      "id": "0014-stripe-no-timestamp-with-a-window",
      "title": "A scheme with a replay window and a delivery with no timestamp — refused",
      "input": {
        "scheme": {
          "algorithm": "SHA-256",
          "payload": "{timestamp}.{body}",
          "encoding": "hex",
          "tolerance": 300
        },
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": null,
        "now": 1614265340,
        "raw": "{\"type\":\"email.received\",\"data\":{\"email_id\":\"56761188-7520-42d8-8898-ff6fc54ce618\"}}",
        "signatures": [
          "b540e1a5b5a47a3377021b8a104ad6cac0d4cb9c8a9f8c7d54514aa036cc5bce"
