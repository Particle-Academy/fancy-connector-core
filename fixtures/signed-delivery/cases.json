    {
      "id": "0011-stripe-valid",
      "title": "Stripe: timestamp.body, a text key, a hex signature — accepted",
      "input": {
        "scheme": {
          "algorithm": "SHA-256",
          "payload": "{timestamp}.{body}",
          "encoding": "hex",
          "tolerance": 300
