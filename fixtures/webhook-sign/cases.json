{
  "about": "Outgoing webhook signing, Standard Webhooks v1 (HMAC-SHA256). Read by tests/webhook-sign.test.ts and php/tests/WebhookSignerTest.php. Every expectation is written here, never captured from the code under test.",
  "cases": [
    {
      "id": "0001-spec-vector",
      "title": "Standard Webhooks' published vector (JavaScript library test, 'sign')",
      "source": "https://github.com/standard-webhooks/standard-webhooks/blob/main/libraries/javascript/src/webhook.test.ts#L240-L249",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        }
      }
    },
    {
      "id": "0002-spec-binary-vector",
      "title": "A body that is not valid UTF-8 (every byte value) is signed byte for byte; the Go library's answer",
      "source": "https://github.com/standard-webhooks/standard-webhooks/blob/main/libraries/javascript/src/webhook.test.ts ('sign signs a binary payload byte for byte')",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "bodyBase64": ""
      },
      "expected": {
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,sEcZ042G8Crqgxbybb3y0eDxQR3TcfYsk11I1XULhSI="
        }
      }
    },
    {
      "id": "0003-rotation-two-secrets",
      "title": "During a rotation, one signature per secret, space-delimited, in the order given",
      "source": "the spec's 'webhook-signature' section; the first signature is computed with node:crypto",
      "input": {
        "secrets": [
          "whsec_AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,frM35V2Z51bxs4v81I6TpLnscXkhXtKLP/7WPYVyj3A= v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        }
      }
    },
    {
      "id": "0004-empty-body",
      "title": "An empty body is signed: the signed content is 'id.timestamp.'",
      "source": "computed with node:crypto",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "body": ""
      },
      "expected": {
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,v48jdbgvh29KJz2Qc+ghw8G6vG3nAKnujWBg8oM/62A="
        }
      }
    },
    {
      "id": "0005-no-secret",
      "title": "No secret at all is refused, never sent unsigned",
      "input": {
        "secrets": [],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "no-secret"
      }
    },
    {
      "id": "0006-bad-prefix",
      "title": "A secret without whsec_ is refused by name, not signed as text",
      "input": {
        "secrets": [
          "MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "bad-secret"
      }
    },
    {
      "id": "0007-bad-base64",
      "title": "A whsec_ secret that is not base64 is refused by name",
      "input": {
        "secrets": [
          "whsec_not base64!"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "bad-secret"
      }
    },
    {
      "id": "0008-id-newline",
      "title": "An id containing CR or LF is refused: it would inject a header",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_1\r\nX-Evil: 1",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "bad-id"
      }
    },
    {
      "id": "0009-empty-id",
      "title": "An empty id is refused",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "",
        "timestamp": 1614265330,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "bad-id"
      }
    },
    {
      "id": "0010-timestamp-ms",
      "title": "A timestamp in MILLISECONDS is refused: the header is seconds, and every receiver would reject it as out of tolerance",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": 1614265330000,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "bad-timestamp"
      }
    },
    {
      "id": "0011-timestamp-negative",
      "title": "A negative timestamp is refused",
      "input": {
        "secrets": [
          "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
        ],
        "id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
        "timestamp": -1,
        "body": "{\"test\": 2432232314}"
      },
      "expected": {
        "refused": "bad-timestamp"
      }
    }
  ]
}
